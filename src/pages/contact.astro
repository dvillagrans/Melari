---
import MainLayout from '../layouts/main-layout.astro'
import ContactInfo from '../components/contact-box.tsx'
import ContactForm from '../components/contact-form.tsx'
import { isLive, business, phoneHref, whatsappHref, ctaLabel } from '../lib/business'
---


<MainLayout
  title={`Contacto | ${business.name}`}
  description="Contáctanos para agendar tu cita o resolver tus dudas sobre los tratamientos y terapias de Melari Spa."
>

  <!-- Page header -->
  <section class="relative w-full overflow-hidden bg-paper">
    <div
      aria-hidden="true"
      class="absolute inset-y-0 right-0 w-1/3 bg-paper-soft/60 hidden lg:block"
    ></div>
    <div class="relative w-full max-w-[1200px] mx-auto px-5 md:px-12 xl:px-0 pt-[150px] lg:pt-[190px] pb-[90px] lg:pb-[110px]">
      <p class="eyebrow text-accent flex items-center gap-4">
        <span aria-hidden="true" class="inline-block h-px w-10 bg-line"></span>
        <a href="/" class="hover:text-accent-dark transition-colors">Inicio</a>
        <span aria-hidden="true">/</span>
        Contacto
      </p>
      <h1
        class="mt-6 font-dm text-[34px] leading-[1.08] md:text-[56px] text-ink max-w-[18ch]"
      >
        Nos encanta conocer nuevas personas y ayudarlas.
      </h1>
      <p class="mt-7 font-jost text-base md:text-lg leading-[30px] text-ink-soft max-w-[52ch]">
        Escríbenos para agendar una cita o resolver tus dudas sobre los
        tratamientos y terapias de Melari Spa.
      </p>
    </div>
  </section>

  <!-- Contact info band -->
  <section class="w-full bg-ink text-white">
    <div class="w-full max-w-[1200px] mx-auto px-5 md:px-12 xl:px-0 py-[80px] lg:py-[100px]">
      <ContactInfo />
    </div>
  </section>

  <!-- Form section: only when there's a real channel in live mode. -->
  {
    isLive && business.email ? (
      <section class="lg:max-w-[1200px] px-5 md:px-12 xl:px-0 w-full mx-auto pt-[80px] lg:pt-[110px] pb-[120px]">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-4 lg:pt-2">
            <p class="eyebrow text-accent flex items-center gap-4">
              <span aria-hidden="true" class="inline-block h-px w-10 bg-line"></span>
              Escríbenos
            </p>
            <h2 class="mt-5 font-dm text-[30px] leading-[1.12] md:text-[38px] text-ink max-w-[14ch]">
              Cuéntanos qué necesitas
            </h2>
            <p class="mt-5 font-jost text-base leading-[28px] text-ink-soft max-w-[38ch]">
              Completa el formulario y te responderemos a la brevedad.
            </p>
          </div>
          <div class="lg:col-span-8">
            <ContactForm enabled actionHref={`mailto:${business.email}`} />
          </div>
        </div>
      </section>
    ) : (
      <section class="lg:max-w-[1200px] px-5 md:px-12 xl:px-0 w-full mx-auto pt-[80px] lg:pt-[110px] pb-[120px]">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-4 lg:pt-2">
            <p class="eyebrow text-accent flex items-center gap-4">
              <span aria-hidden="true" class="inline-block h-px w-10 bg-line"></span>
              Escríbenos
            </p>
            <h2 class="mt-5 font-dm text-[30px] leading-[1.12] md:text-[38px] text-ink max-w-[14ch]">
              ¿Prefieres escribirnos?
            </h2>
            <p class="mt-5 font-jost text-base leading-[28px] text-ink-soft max-w-[38ch]">
              El canal de mensajes está pendiente de configuración. Mientras
              tanto, explora nuestros servicios o escríbenos por los canales
              disponibles.
            </p>
          </div>
          <div class="lg:col-span-8">
            <div class="paper-frame rounded-card p-8 md:p-10 flex flex-col gap-6">
              <p class="font-jost text-base md:text-lg leading-[30px] text-ink-soft max-w-[52ch]">
                Pronto podrás escribirnos directamente desde aquí. Mientras
                tanto puedes:
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a
                  href="/services"
                  class="rounded-full bg-primary-200 px-8 py-4 text-center text-white font-semibold tracking-tight hover:bg-accent-dark transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                >
                  {ctaLabel}
                </a>
                {whatsappHref && (
                  <a
                    href={whatsappHref}
                    class="rounded-full border border-ink/25 px-8 py-4 text-center text-ink font-semibold tracking-tight hover:border-accent hover:text-accent transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                  >
                    WhatsApp
                  </a>
                )}
                {phoneHref && !whatsappHref && (
                  <a
                    href={phoneHref}
                    class="rounded-full border border-ink/25 px-8 py-4 text-center text-ink font-semibold tracking-tight hover:border-accent hover:text-accent transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                  >
                    Llamar
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

</MainLayout>
