---
import MainLayout from '../layouts/main-layout.astro'
import ContactInfo from '../components/contact-box.tsx'
import ContactForm from '../components/contact-form.tsx'
---


<MainLayout
  title="Contacto | Melari Spa"
  description="Contáctanos para agendar tu cita o resolver tus dudas sobre los tratamientos y terapias de Melari Spa."
>

  <!-- Page header -->

  <section class="w-full max-w-[1200px] mx-auto px-5 md:px-12 xl:px-0 pt-[140px] lg:pt-[180px]">
    <p class="eyebrow text-accent flex items-center gap-4">
      <span aria-hidden="true" class="inline-block h-px w-10 bg-line"></span>
      <a href="/" class="hover:text-accent-dark transition-colors">Inicio</a>
      <span aria-hidden="true">/</span>
      Contacto
    </p>
    <h1
      class="mt-6 font-dm text-[34px] leading-[1.1] md:text-[54px] text-ink max-w-[20ch]"
    >
      Nos encanta conocer nuevas personas y ayudarlas.
    </h1>
    <p class="mt-6 font-jost text-base md:text-lg leading-[30px] text-ink-soft max-w-[52ch]">
      Escríbenos para agendar una cita o resolver tus dudas sobre los
      tratamientos y terapias de Melari Spa.
    </p>
  </section>

  <!-- main section -->
  <section class="lg:max-w-[1200px] px-5 md:px-12 xl:px-0 w-full mx-auto pt-[80px] lg:pt-[100px]">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-[55px] items-start">
      <ContactInfo />
      <ContactForm />
    </div>
  </section>

 

</MainLayout>

<style>

  /* Hide scrollbar for Chrome, Safari and Opera */
  .no-scrollbar::-webkit-scrollbar {
      display: none;
  }

  /* Hide scrollbar for IE, Edge and Firefox */
  .no-scrollbar {
      -ms-overflow-style: none;  /* IE and Edge */
      scrollbar-width: none;  /* Firefox */
  }

</style>