---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/main-layout.astro";
import { serviceSlug } from "../../lib/slug";

export async function getStaticPaths() {
  const services = await getCollection(
    "services",
    ({ data }) => !data.provisional,
  );
  return services.map((entry) => ({
    params: { slug: serviceSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { name, text, img } = data;
---

<MainLayout
  title={`${name} | Melari Spa`}
  description={data.description ?? data.text}
>
  <section class="w-full bg-services h-[50vh] flex justify-center items-end">
    <div
      class="py-[30px] lg:py-[41px] px-[60px] lg:px-[152px] flex flex-col justify-center items-center bg-white rounded-tl-[37px] rounded-tr-[37px] gap-2.5"
    >
      <h1
        class="text-[30px] leading-[40px] lg:text-[50px] lg:leading-[62px] font-dm capitalize text-primary-200 text-center"
      >
        {name}
      </h1>
      <nav aria-label="Breadcrumb">
        <ol
          class="flex flex-wrap items-center gap-2 text-base lg:text-[22px] lg:leading-[33px] tracking-tight font-jost text-text-gray"
        >
          <li>
            <a href="/" class="hover:text-primary-200">Inicio</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/services" class="hover:text-primary-200">Servicios</a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{name}</li>
        </ol>
      </nav>
    </div>
  </section>

  <section
    class="lg:max-w-[1200px] px-5 md:px-12 xl:px-0 w-full mx-auto pt-[100px] lg:pt-[120px] pb-[120px]"
  >
    <div
      class="w-full flex flex-col lg:grid lg:grid-cols-2 gap-10 lg:gap-[75px] items-start"
    >
      <img
        src={img}
        alt={name}
        width={1280}
        height={853}
        loading="lazy"
        decoding="async"
        class="w-full h-auto rounded-[20px]"
      />
      <div class="flex flex-col gap-6">
        <p
          class="text-base md:text-[22px] tracking-tight font-jost text-text-gray leading-[33px]"
        >
          {text}
        </p>
        {data.description && (
          <p
            class="text-base md:text-[22px] tracking-tight font-jost text-text-gray leading-[33px]"
          >
            {data.description}
          </p>
        )}
        {(data.duration || data.price) && (
          <dl class="flex flex-col gap-3 text-base md:text-lg font-jost tracking-tight text-text-blue">
            {data.duration && (
              <div class="flex gap-2">
                <dt class="font-semibold">Duración:</dt>
                <dd>{data.duration}</dd>
              </div>
            )}
            {data.price && (
              <div class="flex gap-2">
                <dt class="font-semibold">Precio:</dt>
                <dd>{data.price}</dd>
              </div>
            )}
          </dl>
        )}
        {data.benefits && data.benefits.length > 0 && (
          <div>
            <h2 class="font-dm text-[24px] lg:text-[30px] text-text-blue mb-3">
              Beneficios
            </h2>
            <ul
              class="list-disc pl-5 flex flex-col gap-2 text-base md:text-[22px] tracking-tight font-jost text-text-gray leading-8"
            >
              {data.benefits.map((benefit) => <li>{benefit}</li>)}
            </ul>
          </div>
        )}
        <div class="pt-3">
          <button
            type="button"
            disabled
            aria-disabled="true"
            class="rounded-[18px] flex capitalize items-center justify-center gap-[9px] w-fit text-white text-base lg:text-lg font-semibold font-['Jost'] leading-snug tracking-tight px-10 py-5 md:px-[54px] md:py-[26px] bg-primary-200"
          >
            Agendar cita
          </button>
          <p
            id="reserva-proximamente"
            class="mt-3 text-sm md:text-base font-jost tracking-tight text-text-gray-200"
          >
            La reserva en línea aún no está integrada con TimeUp. Estará
            disponible próximamente.
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
