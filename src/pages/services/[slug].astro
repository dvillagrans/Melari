---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/main-layout.astro";
import { serviceSlug } from "../../lib/slug";
import { isLive, conversionChannel, ctaLabel } from "../../lib/business";

export async function getStaticPaths() {
  const services = await getCollection(
    "services",
    ({ data }) => !data.provisional,
  );
  return services.map((entry) => ({
    params: { slug: serviceSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { name, text, img } = data;
---

<MainLayout
  title={`${name} | Melari Spa`}
  description={data.description ?? data.text}
>
  <!-- Page header -->
  <section class="w-full max-w-[1200px] mx-auto px-5 md:px-12 xl:px-0 pt-[140px] lg:pt-[180px]">
    <nav aria-label="Breadcrumb">
      <ol
        class="flex flex-wrap items-center gap-2 eyebrow text-ink-soft"
      >
        <li>
          <a href="/" class="link-draw hover:text-ink">Inicio</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/services" class="link-draw hover:text-ink">Servicios</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink">{name}</li>
      </ol>
    </nav>
    <h1
      class="mt-6 font-dm text-[34px] leading-[1.1] md:text-[54px] text-ink max-w-[18ch]"
    >
      {name}
    </h1>
  </section>

  <section
    class="lg:max-w-[1200px] px-5 md:px-12 xl:px-0 w-full mx-auto pt-[70px] lg:pt-[90px] pb-[120px]"
  >
    <div
      class="w-full grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-[75px] items-start"
    >
      <div class="lg:col-span-6">
        <figure class="paper-frame rounded-card overflow-hidden">
          <img
            src={img}
            alt={name}
            width={1280}
            height={853}
            loading="lazy"
            decoding="async"
            class="w-full aspect-[4/3] object-cover"
          />
        </figure>
      </div>
      <div class="lg:col-span-6 flex flex-col gap-7">
        <p
          class="font-jost text-base md:text-lg leading-[30px] text-ink-soft"
        >
          {text}
        </p>
        {data.description && (
          <p
            class="font-jost text-base md:text-lg leading-[30px] text-ink-soft"
          >
            {data.description}
          </p>
        )}
        {(data.duration || data.price) && (
          <dl class="flex flex-col gap-3 font-jost text-base md:text-lg tracking-tight text-ink">
            {data.duration && (
              <div class="flex gap-2">
                <dt class="font-semibold">Duración:</dt>
                <dd class="text-ink-soft">{data.duration}</dd>
              </div>
            )}
            {data.price && (
              <div class="flex gap-2">
                <dt class="font-semibold">Precio:</dt>
                <dd class="text-ink-soft">{data.price}</dd>
              </div>
            )}
          </dl>
        )}
        {data.benefits && data.benefits.length > 0 && (
          <div>
            <h2 class="font-dm text-[24px] lg:text-[28px] text-ink mb-4">
              Beneficios
            </h2>
            <ul
              class="list-disc pl-5 flex flex-col gap-2 font-jost text-base md:text-lg leading-8 text-ink-soft"
            >
              {data.benefits.map((benefit) => <li>{benefit}</li>)}
            </ul>
          </div>
        )}
        <div class="pt-4 border-t border-line">
          {
            isLive && conversionChannel ? (
              <a
                href={conversionChannel.href}
                class="rounded-full inline-flex capitalize items-center justify-center gap-[9px] w-fit text-white text-base lg:text-lg font-semibold font-['Jost'] leading-snug tracking-tight px-10 py-4 md:px-[44px] md:py-[20px] bg-primary-200 transition-colors duration-300 hover:bg-accent-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
              >
                {ctaLabel}
              </a>
            ) : (
              <>
                <a
                  href="/contact"
                  class="rounded-full inline-flex capitalize items-center justify-center gap-[9px] w-fit text-white text-base lg:text-lg font-semibold font-['Jost'] leading-snug tracking-tight px-10 py-4 md:px-[44px] md:py-[20px] bg-primary-200 transition-colors duration-300 hover:bg-accent-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                >
                  Agendar cita
                </a>
                <p
                  id="reserva-proximamente"
                  class="mt-4 text-sm md:text-base font-jost tracking-tight text-ink-soft"
                >
                  La reserva en línea aún no está integrada con TimeUp. Estará
                  disponible próximamente.
                </p>
              </>
            )
          }
        </div>
      </div>
    </div>
  </section>
</MainLayout>
