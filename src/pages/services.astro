---
import { getCollection } from "astro:content";
import { AnimatedProjectsSection } from "../components/AnimatedProjectsSection";
import MainLayout from "../layouts/main-layout.astro";
import { serviceSlug } from "../lib/slug";

const projects = (
  await getCollection("services", ({ data }) => !data.provisional)
)
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((entry) => ({
    img: entry.data.img,
    name: entry.data.name,
    text: entry.data.text,
    href: `/services/${serviceSlug(entry)}`,
  }));
---

<MainLayout
  title="Servicios | Melari Spa"
  description="Explora los servicios de Melari Spa: masajes, terapias, faciales y nutrición para cuerpo y mente."
>
  <!-- Page header -->
  <section class="w-full max-w-[1200px] mx-auto px-5 md:px-12 xl:px-0 pt-[140px] lg:pt-[180px]">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 eyebrow text-ink-soft">
        <li>
          <a href="/" class="link-draw hover:text-ink">Inicio</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink">Servicios</li>
      </ol>
    </nav>
    <h1
      class="mt-6 font-dm text-[34px] leading-[1.1] md:text-[54px] text-ink max-w-[16ch]"
    >
      Servicios
    </h1>
    <p class="mt-6 font-jost text-base md:text-lg leading-[30px] text-ink-soft max-w-[52ch]">
      Masajes, terapias, faciales y nutrición para cuerpo y mente. Elige el
      tratamiento que mejor acompañe tu momento.
    </p>
  </section>

  <!-- Services Section -->
  <AnimatedProjectsSection projects={projects} />
</MainLayout>
