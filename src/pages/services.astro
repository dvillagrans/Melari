---
import { getCollection } from "astro:content";
import { AnimatedProjectsSection } from "../components/AnimatedProjectsSection";
import MainLayout from "../layouts/main-layout.astro";
import { serviceSlug } from "../lib/slug";

const projects = (
  await getCollection("services", ({ data }) => !data.provisional)
)
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((entry) => ({
    img: entry.data.img,
    name: entry.data.name,
    text: entry.data.text,
    href: `/services/${serviceSlug(entry)}`,
  }));
---

<MainLayout
  title="Servicios | Melari Spa"
  description="Explora los servicios de Melari Spa: masajes, terapias, faciales y nutrición para cuerpo y mente."
>
  <!-- Banner Section -->
  <section class="w-full bg-services h-[50vh] flex justify-center items-end">
    <div
      class="py-[30px] lg:py-[41px] px-[60px] lg:px-[152px] flex flex-col justify-center items-center bg-white rounded-tl-[37px] rounded-tr-[37px] gap-2.5"
    >
      <h1
        class="text-[30px] leading-[40px] lg:text-[50px] lg:leading-[62px] font-dm capitalize text-primary-200"
      >
        Servicios
      </h1>
      <p
        class="text-base lg:text-[22px] lg:leading-[33px] tracking-tight font-jost text-text-gray"
      >
        <a href="/">Inicio</a> / Servicios
      </p>
    </div>
  </section>

  <!-- Services Section -->
  <AnimatedProjectsSection projects={projects} />
</MainLayout>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  /* Hide scrollbar for IE, Edge and Firefox */
  .no-scrollbar {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
</style>
