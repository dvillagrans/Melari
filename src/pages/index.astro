---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/main-layout.astro";
import Button from "../components/button.tsx";
import CallIcon from "../icons/call.tsx";
import { AnimatedServicesSection } from "../components/AnimatedServicesSection";
import { AnimatedVideoSection } from "../components/AnimatedVideoSection";
import { AnimatedExperienceSection } from "../components/AnimatedExperienceSection";
import { AnimatedProjectsSection } from "../components/AnimatedProjectsSection";
import MapsSection from "../components/MapsSection";
import { serviceSlug } from "../lib/slug";

const services = (await getCollection("highlights")).map(({ data }) => ({
  img: data.img,
  title: data.title,
  text: data.text,
}));

const reviews = (
  await getCollection("testimonials", ({ data }) => !data.provisional)
).map(({ data }) => ({
  img: data.img,
  name: data.name,
  location: data.location,
  review: data.review,
}));

const projects = (
  await getCollection("services", ({ data }) => data.featured && !data.provisional)
).map((entry) => ({
  img: entry.data.img,
  name: entry.data.name,
  text: entry.data.text,
  href: `/services/${serviceSlug(entry)}`,
}));

const experiences = (
  await getCollection("stats", ({ data }) => !data.provisional)
).map(({ data }) => ({
  text: data.text,
  num: data.num,
}));
---

<MainLayout
  title="Melari Spa | Spa y Terapia Alternativa"
  description="Melari Spa y Terapia Alternativa — masajes, tratamientos faciales y terapias de bienestar para cuerpo y mente."
>
  <!-- Banner -->

  <section
    class="hero relative w-full bg-hero bg-no-repeat bg-cover bg-center min-h-screen min-h-dvh flex items-center overflow-hidden"
  >
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-linear-to-b from-black/60 via-black/30 to-black/60"
    ></div>
    <div
      class="relative z-10 w-full max-w-[1200px] mx-auto px-5 md:px-12 py-24 md:py-32 flex flex-col"
    >
      <p
        class="font-jost text-sm md:text-base uppercase tracking-[0.35em] text-primary-100 mb-5"
      >
        Melari Spa
      </p>
      <h1
        class="font-dm text-white text-[clamp(2.5rem,7vw,6rem)] leading-[1.06] md:leading-[1.08] max-w-[16ch]"
      >
        SPA & TERAPIA ALTERNATIVA
      </h1>
      <span aria-hidden="true" class="block h-px w-16 bg-primary-100/80 my-6"></span>
      <p
        class="font-jost text-white/90 text-base md:text-[22px] leading-relaxed md:leading-[33px] max-w-[46ch]"
      >
        En cada rincón de nuestro spa, encontrarás un refugio de calma y
        armonía. Cada detalle ha sido cuidadosamente diseñado para ofrecerte una
        experiencia única.
      </p>
      <!-- Booking CTA redirects to /contact. Online booking is NOT integrated with TimeUp (see services/[slug].astro). -->
      <div class="mt-9">
        <Button text="Agendar una cita" href="/contact" />
      </div>
    </div>
  </section>

  <!-- Services Section -->

  <AnimatedServicesSection services={services} client:visible />

  <!-- About Section -->

  <section
    class="w-full lg:max-w-[1200px] mx-auto px-5 md:px-12 xl:px-0 flex flex-col-reverse justify-center items-center lg:grid grid-cols-2 gap-[75px] pt-[100px] lg:pt-[200px]"
  >
    <div
      class="flex flex-col gap-8 max-w-[472px] items-center lg:items-start py-6"
    >
      <h2
        class="text-[30px] text-center capitalize lg:text-left font-dm tracking-wide leading-8 md:leading-[62.50px] md:text-[50px] text-text-blue"
      >
        SPA Profesional & Servicios de Cuidado Personal
      </h2>
      <p
        class="text-base md:text-[22px] text-center lg:text-left tracking-tight font-jost text-text-gray leading-[33px]"
      >
        En Melari, nos enorgullecemos de ser el mejor spa y proveedor de
        servicios de cuidado personal. Nuestra dedicación a la excelencia y el
        bienestar de nuestros clientes nos distingue. Con una amplia gama de
        tratamientos y terapias, ofrecemos una experiencia única que
        transformará tu cuerpo y mente.
      </p>
      <div class="flex gap-4 pt-3 items-center">
        <CallIcon />
        <p class="flex flex-col text-text-gray-200 font-jost tracking-tight">
          <span class="text-[22px] leading-8">Llámanos a cualquier hora</span>
        </p>
      </div>
      <!-- Booking CTA redirects to /contact. Online booking is NOT integrated with TimeUp (see services/[slug].astro). -->
      <Button text="Agenda una cita" href="/contact" />
    </div>

    <div>
      <img
        src="/about.webp"
        alt=""
        width={4196}
        height={6294}
        loading="lazy"
        decoding="async"
        class="w-full h-auto"
      />
    </div>
  </section>

  <!--Video Section -->

  <AnimatedVideoSection
    title="Conoce nuestras instalaciones y déjate consentir"
    videoSrc="/about.mp4"
    client:visible
  />

  <!-- What People Think About Us Section -->

  {reviews.length > 0 && (
    <section
      class="lg:max-w-[1200px] px-5 md:px-12 xl:px-0 w-full mx-auto pt-[100px] lg:pt-[100px]"
    >
      <div
        class="w-full flex flex-col bg-primary-300 rounded-[48px] px-6 py-[88px]"
      >
        <h2
          class="font-dm tracking-wide text-center leading-[37px] lg:leading-[62.50px] text-[30px] lg:text-[50px] w-full lg:max-w-[50%] pb-9 mx-auto"
        >
          Lo que las personas piensan de nosotros
        </h2>
        <div class="lg:flex-row justify-between">
          {
            reviews.map((rev) => {
              return (
                <div class="w-full bg-white max-w-[420px] px-[45px] py-[53px] rounded-3xl mx-auto">
                  <div class="flex flex-col sm:flex-row gap-6 items-center">
                    <img src={rev.img} alt="" />
                    <p class="flex flex-col tracking-tight leading-9">
                      <span class="text-primary-200 text-lg lg:text-[25px] font-dm">
                        {rev.name}
                      </span>
                      <span class="text-text-gray-200 text-base lg:text-lg font-jost">
                        {rev.location}
                      </span>
                    </p>
                  </div>
                  <p class="font-jost tracking-tight leading-8 text-base text-center sm:text-left text-text-gray lg:text-[22px] mt-4">
                    {rev.review}
                  </p>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>
  )}

  <!-- Projects Section -->

  <AnimatedProjectsSection projects={projects} />

  <!-- Experience Section -->
  {experiences.length > 0 && (
    <AnimatedExperienceSection experiences={experiences} client:visible />
  )}

  <!-- google maps direcction -->
  <MapsSection />

  <!--Style Section -->
  <style>
    /* The `.hero` rule guarantees a deterministic dvh fallback: Tailwind
       emits `.min-h-dvh` before `.min-h-screen`, so `100vh` would otherwise
       win the cascade and the dynamic viewport height would never apply. */
    .hero {
      min-height: 100vh;
    }

    @supports (min-height: 100dvh) {
      .hero {
        min-height: 100dvh;
      }
    }

    /* Hide scrollbar for Chrome, Safari and Opera */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }

    /* Hide scrollbar for IE, Edge and Firefox */
    .no-scrollbar {
      -ms-overflow-style: none; /* IE and Edge */
      scrollbar-width: none; /* Firefox */
    }

    .hidden {
      opacity: 0;
      transform: translateX(-100vw);
    }

    .show {
      opacity: 1;
      transform: translateX(0);
      transition: all 0.5s ease;
    }
  </style>
</MainLayout>
