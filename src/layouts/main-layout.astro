---
import Navbar from "../components/navbar.tsx";
import Footer from "../components/footer.tsx";
import "../styles/global.css";

export interface LayoutProps {
  title: string;
  description?: string;
}

const DEFAULT_DESCRIPTION =
  "Melari Spa y Terapia Alternativa — masajes, tratamientos faciales y terapias de bienestar para cuerpo y mente.";

const { title } = Astro.props as LayoutProps;
const description = Astro.props.description ?? DEFAULT_DESCRIPTION;
---

<html lang="es" class="no-js">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.remove("no-js");
      document.documentElement.classList.add("js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Melari Spa" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/banner.webp" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content="/banner.webp" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Jost:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <link rel="icon" href="/MELARIICON.jpg" />
  </head><body>
    <main class="bg-main bg-no-repeat bg-cover bg-center">
      <Navbar client:load />
      <slot />
      <!-- All different pages to be rendered here -->
      <Footer />
    </main>
    <script src="//code.tidio.co/eytnto8chqpwuaglmim8cv0bmbotyvvp.js" is:inline async
    ></script>
  </body>
</html>
