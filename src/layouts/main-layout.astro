---
import Navbar from "../components/navbar.tsx";
import Footer from "../components/footer.astro";
import "../styles/global.css";
import {
  isLive,
  canonicalUrl,
  business,
  jsonLdOpeningHours,
} from "../lib/business";

export interface LayoutProps {
  title: string;
  description?: string;
}

const DEFAULT_DESCRIPTION =
  "Melari Spa y Terapia Alternativa — masajes, tratamientos faciales y terapias de bienestar para cuerpo y mente.";

const { title } = Astro.props as LayoutProps;
const description = Astro.props.description ?? DEFAULT_DESCRIPTION;

// Canonical for the current page (full URL) or "" when not live.
const canonical = canonicalUrl
  ? `${canonicalUrl}${Astro.url.pathname === "/" ? "" : Astro.url.pathname}`
  : "";

const social = {
  facebook: "",
  instagram: "",
  tiktok: "",
};
const socialLinks = Object.entries(social).filter(([, url]) => url);

// LocalBusiness JSON-LD — only in live mode, only with a domain.
const localBusinessJsonLd = (() => {
  if (!isLive || !canonicalUrl) return null;
  return {
    "@context": "https://schema.org",
    "@type": "HealthAndBeautyBusiness",
    name: business.name,
    description: business.description,
    url: canonicalUrl,
    telephone: business.phone,
    email: business.email,
    image: `${canonicalUrl}${business.ogImage}`,
    address: {
      "@type": "PostalAddress",
      streetAddress: business.address,
      addressLocality: business.city,
      addressRegion: business.region,
      postalCode: business.postalCode,
      addressCountry: business.country,
    },
    ...(business.latitude !== undefined &&
    business.longitude !== undefined
      ? { geo: { "@type": "GeoCoordinates", latitude: business.latitude, longitude: business.longitude } }
      : {}),
    ...(jsonLdOpeningHours
      ? { openingHoursSpecification: jsonLdOpeningHours }
      : {}),
    ...(socialLinks.length > 0
      ? { sameAs: socialLinks.map(([, url]) => url) }
      : {}),
  };
})();
---

<html lang="es" class="no-js">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.remove("no-js");
      document.documentElement.classList.add("js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {isLive ? (
      <>
        <link rel="canonical" href={canonical} />
        {localBusinessJsonLd && (
          <script
            type="application/ld+json"
            set:html={JSON.stringify(localBusinessJsonLd)}
            is:inline
          />
        )}
      </>
    ) : (
      <meta name="robots" content="noindex, nofollow" />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content={business.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={canonical ? `${canonicalUrl}${business.ogImage}` : business.ogImage} />
    {canonical && <meta property="og:url" content={canonical} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={business.ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&display=swap"
      as="style"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Jost:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <link rel="icon" href="/MELARIICON.jpg" />
  </head><body>
    <main class="bg-main bg-no-repeat bg-cover bg-center">
      <Navbar client:load />
      <slot />
      <!-- All different pages to be rendered here -->
      <Footer />
    </main>
    {
      // Tidio chat widget: only in live mode. It is a third-party script and
      // out of the approved editorial scope; preview builds must not load it.
      // Decision recorded in docs/go-live-checklist.md.
      isLive && (
        <script
          src="//code.tidio.co/eytnto8chqpwuaglmim8cv0bmbotyvvp.js"
          is:inline
          async
        ></script>
      )
    }
  </body>
</html>
